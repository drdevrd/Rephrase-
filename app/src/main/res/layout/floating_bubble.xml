<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="360dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bubble_bg"
    android:padding="16dp"
    android:elevation="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✨ RePhrase as..."
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#58a6ff"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">
        <Button android:id="@+id/btn_formal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="🎩 Formal" android:textSize="11sp" android:backgroundTint="#1f6feb" android:layout_marginEnd="5dp" android:textAllCaps="false"/>
        <Button android:id="@+id/btn_casual" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="😊 Casual" android:textSize="11sp" android:backgroundTint="#1f6feb" android:layout_marginEnd="5dp" android:textAllCaps="false"/>
        <Button android:id="@+id/btn_medical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="🩺 Medical" android:textSize="11sp" android:backgroundTint="#1f6feb" android:textAllCaps="false"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">
        <Button android:id="@+id/btn_simple" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="👶 Simple" android:textSize="11sp" android:backgroundTint="#238636" android:layout_marginEnd="5dp" android:textAllCaps="false"/>
        <Button android:id="@+id/btn_empathy" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="💙 Empathy" android:textSize="11sp" android:backgroundTint="#238636" android:layout_marginEnd="5dp" android:textAllCaps="false"/>
        <Button android:id="@+id/btn_concise" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="⚡ Concise" android:textSize="11sp" android:backgroundTint="#238636" android:textAllCaps="false"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">
        <Button android:id="@+id/btn_natural" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="🌿 Natural" android:textSize="11sp" android:backgroundTint="#6e40c9" android:layout_marginEnd="5dp" android:textAllCaps="false"/>
        <Button android:id="@+id/btn_discharge" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="📋 Discharge" android:textSize="11sp" android:backgroundTint="#6e40c9" android:layout_marginEnd="5dp" android:textAllCaps="false"/>
        <Button android:id="@+id/btn_tamil" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="🌐 Tamil" android:textSize="11sp" android:backgroundTint="#6e40c9" android:textAllCaps="false"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">
        <Button android:id="@+id/btn_grammar" android:layout_width="match_parent" android:layout_height="52dp" android:text="✍️ Check &amp; Fix Grammar" android:textSize="12sp" android:backgroundTint="#b08800" android:textAllCaps="false"/>
    </LinearLayout>

    <!-- Custom Tones Row -->
    <LinearLayout
        android:id="@+id/customTonesRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp"
        android:visibility="gone">
        <Button android:id="@+id/btn_custom1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="⭐ Custom 1" android:textSize="11sp" android:backgroundTint="#c05800" android:layout_marginEnd="5dp" android:textAllCaps="false"/>
        <Button android:id="@+id/btn_custom2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="⭐ Custom 2" android:textSize="11sp" android:backgroundTint="#c05800" android:layout_marginEnd="5dp" android:textAllCaps="false"/>
        <Button android:id="@+id/btn_custom3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="⭐ Custom 3" android:textSize="11sp" android:backgroundTint="#c05800" android:textAllCaps="false"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#30363d"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/statusMsg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:textColor="#58a6ff"
        android:layout_marginBottom="8dp"/>

    <!-- Grammar result — shown only for grammar check -->
    <ScrollView
        android:id="@+id/grammarScroll"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:visibility="gone"
        android:layout_marginBottom="8dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/grammarCorrected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:textColor="#ffffff"
                android:background="#2ea043"
                android:padding="12dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/grammarExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="#c9d1d9"
                android:background="#21262d"
                android:padding="12dp"/>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_use_grammar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="✅ Use Corrected Text"
        android:textSize="13sp"
        android:backgroundTint="#238636"
        android:textAllCaps="false"
        android:visibility="gone"
        android:layout_marginBottom="8dp"/>

    <!-- Rephrase options — shown for all other tones -->
    <ScrollView
        android:id="@+id/optionsScroll"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/optionsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap an option to use it:"
                android:textSize="11sp"
                android:textColor="#6e7681"
                android:layout_marginBottom="6dp"/>

            <Button
                android:id="@+id/btn_option1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:backgroundTint="#2ea043"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_marginBottom="6dp"/>

            <Button
                android:id="@+id/btn_option2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:backgroundTint="#2ea043"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_marginBottom="6dp"/>

            <Button
                android:id="@+id/btn_option3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:backgroundTint="#2ea043"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_marginBottom="6dp"/>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_close_top"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="✕ Close"
        android:textSize="13sp"
        android:backgroundTint="#6e7681"
        android:textAllCaps="false"
        android:visibility="visible"/>

</LinearLayout>
