<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#EE1a1f2e"
    android:padding="10dp">

    <!-- Top bar: status message + always-visible ✕ close button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">
        <TextView
            android:id="@+id/statusMsg"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="RePhrase"
            android:textColor="#58a6ff"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center_vertical"/>
        <Button
            android:id="@+id/btn_close_x"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="✕"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:textColor="#ffffff"
            android:backgroundTint="#6e1c1c"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"/>
    </LinearLayout>

    <!-- Tone buttons row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">
        <Button android:id="@+id/btn_formal"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp"
            android:text="Formal" android:textSize="11sp" android:textAllCaps="false"
            android:backgroundTint="#1f6feb" android:layout_marginEnd="3dp"/>
        <Button android:id="@+id/btn_casual"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp"
            android:text="Casual" android:textSize="11sp" android:textAllCaps="false"
            android:backgroundTint="#1f6feb" android:layout_marginEnd="3dp"/>
        <Button android:id="@+id/btn_medical"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp"
            android:text="Medical" android:textSize="11sp" android:textAllCaps="false"
            android:backgroundTint="#1f6feb"/>
    </LinearLayout>

    <!-- Tone buttons row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">
        <Button android:id="@+id/btn_simple"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp"
            android:text="Simple" android:textSize="11sp" android:textAllCaps="false"
            android:backgroundTint="#388bfd" android:layout_marginEnd="3dp"/>
        <Button android:id="@+id/btn_concise"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp"
            android:text="Concise" android:textSize="11sp" android:textAllCaps="false"
            android:backgroundTint="#388bfd" android:layout_marginEnd="3dp"/>
        <Button android:id="@+id/btn_natural"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp"
            android:text="Natural" android:textSize="11sp" android:textAllCaps="false"
            android:backgroundTint="#388bfd"/>
    </LinearLayout>

    <!-- Tone buttons row 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">
        <Button android:id="@+id/btn_discharge"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp"
            android:text="Discharge" android:textSize="11sp" android:textAllCaps="false"
            android:backgroundTint="#6e40c9" android:layout_marginEnd="3dp"/>
        <Button android:id="@+id/btn_tamil"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp"
            android:text="Tamil" android:textSize="11sp" android:textAllCaps="false"
            android:backgroundTint="#6e40c9" android:layout_marginEnd="3dp"/>
        <Button android:id="@+id/btn_formal2"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp"
            android:text="Email" android:textSize="11sp" android:textAllCaps="false"
            android:backgroundTint="#6e40c9"/>
    </LinearLayout>

    <!-- Grammar + Ask AI buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">
        <Button android:id="@+id/btn_grammar"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp"
            android:text="Grammar" android:textSize="11sp" android:textAllCaps="false"
            android:backgroundTint="#0e7490" android:layout_marginEnd="3dp"/>
        <Button android:id="@+id/btn_ask_ai"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp"
            android:text="Ask AI" android:textSize="11sp" android:textAllCaps="false"
            android:backgroundTint="#0e7490"/>
    </LinearLayout>

    <!-- Custom tone buttons (hidden until set) -->
    <LinearLayout
        android:id="@+id/customTonesRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginBottom="4dp">
        <Button android:id="@+id/btn_custom1"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp"
            android:text="Custom1" android:textSize="10sp" android:textAllCaps="false"
            android:backgroundTint="#c05800" android:layout_marginEnd="3dp"/>
        <Button android:id="@+id/btn_custom2"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp"
            android:text="Custom2" android:textSize="10sp" android:textAllCaps="false"
            android:backgroundTint="#c05800" android:layout_marginEnd="3dp"/>
        <Button android:id="@+id/btn_custom3"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp"
            android:text="Custom3" android:textSize="10sp" android:textAllCaps="false"
            android:backgroundTint="#c05800"/>
    </LinearLayout>

    <!-- Rephrasing options section (hidden until results arrive) -->
    <!-- Max height so a 10-option list scrolls instead of pushing the bubble off-screen -->
    <ScrollView
        android:id="@+id/optionsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp"
        android:visibility="gone"
        android:layout_marginTop="4dp">
        <LinearLayout
            android:id="@+id/optionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

    <!-- Selectable EditText (all options). EditText supports proper selection on accessibility overlays. -->
    <EditText
        android:id="@+id/optionsSelectable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="300dp"
        android:text=""
        android:textColor="#e6edf3"
        android:textSize="13sp"
        android:background="#161b22"
        android:padding="8dp"
        android:gravity="top|start"
        android:scrollbars="vertical"
        android:inputType="textMultiLine"
        android:visibility="gone"
        android:layout_marginTop="4dp"/>

    <!-- Toggle between buttons view and selectable text view -->
    <Button
        android:id="@+id/btn_toggle_select"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:text="📝 Select partial text"
        android:textSize="12sp"
        android:textAllCaps="false"
        android:backgroundTint="#6e40c9"
        android:visibility="gone"
        android:layout_marginTop="4dp"/>

    <!-- Grammar result section -->
    <ScrollView
        android:id="@+id/grammarScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginTop="4dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/grammarCorrected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#3fb950"
                android:textSize="13sp"
                android:background="#1a3a1a"
                android:padding="8dp"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:id="@+id/grammarExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#8b949e"
                android:textSize="11sp"
                android:padding="4dp"/>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_use_grammar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:text="Use Grammar Fix"
        android:textSize="12sp"
        android:textAllCaps="false"
        android:backgroundTint="#0e7490"
        android:visibility="gone"
        android:layout_marginTop="4dp"/>

    <!-- Ask AI result section — EditText for proper partial selection -->
    <ScrollView
        android:id="@+id/askAiScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="300dp"
        android:visibility="gone"
        android:layout_marginTop="4dp">
        <EditText
            android:id="@+id/askAiResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#e6edf3"
            android:textSize="13sp"
            android:background="#161b22"
            android:padding="8dp"
            android:gravity="top|start"
            android:inputType="textMultiLine"/>
    </ScrollView>

    <!-- Copy Ask AI result button -->
    <Button
        android:id="@+id/btn_copy_ask_ai"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:text="Copy Answer"
        android:textSize="12sp"
        android:textAllCaps="false"
        android:backgroundTint="#0e7490"
        android:visibility="gone"
        android:layout_marginTop="4dp"/>

</LinearLayout>
