<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#0d1117">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✨ RePhrase"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#f0f6fc"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HS Hospital · AI Rephraser"
        android:textSize="13sp"
        android:textColor="#58a6ff"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Claude API Key"
        android:textSize="12sp"
        android:textColor="#6e7681"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/apiKeyInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="sk-ant-api03-..."
        android:inputType="textPassword"
        android:textColor="#e6edf3"
        android:textColorHint="#484f58"
        android:background="@drawable/input_bg"
        android:padding="14dp"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/saveKeyBtn"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Save API Key"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#1f6feb"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="13sp"
        android:textColor="#3fb950"
        android:layout_marginBottom="24dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#21262d"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Step 2 — Enable Accessibility Service"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#c9d1d9"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings → Accessibility → RePhrase → Turn ON"
        android:textSize="13sp"
        android:textColor="#6e7681"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/openAccessibilityBtn"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Open Accessibility Settings"
        android:textSize="14sp"
        android:backgroundTint="#21262d"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="How to use:\n1. Select any text in WhatsApp\n2. A floating bubble appears\n3. Tap your preferred tone\n4. Text is rephrased instantly\n5. Pas
